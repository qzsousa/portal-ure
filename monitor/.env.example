# ============================================================
# MONITOR DVRs — variáveis de ambiente
# Copie para .env ou, melhor, defina como Variável de Ambiente
# do Windows: o serviço precisa delas para subir sozinho.
# ============================================================

# OBRIGATÓRIO. Precisa ser o MESMO valor do JWT_SECRET do backend de
# chamados — é com ele que o monitor valida o token do usuário logado no
# portal. Sem este valor as rotas /api/* respondem 503.
#
# CUIDADO com o nome: o backend de chamados NÃO tem uma variável
# "SSO_SECRET". No SCE o mesmo segredo aparece com esse nome porque quem
# copiou lá chamou assim. No monitor, copie o JWT_SECRET direto.
SSO_SECRET=

# Porta local do serviço. Não precisa estar liberada no roteador: quem fala
# com o navegador é o Cloudflare Tunnel.
PORTA=4000

# Endereço de escuta. 127.0.0.1 (padrão) é o certo quando o túnel roda na mesma
# máquina; 0.0.0.0 só se o túnel estiver em OUTRO equipamento da rede interna.
HOST=127.0.0.1

# Perfis liberados a ver o monitoramento (padrão: matriz).
NIVEIS_PERMITIDOS=ADMIN,TECNICO

# Origens do navegador autorizadas (CORS). VAZIO = qualquer origem, que é
# normal: a API só devolve dado para quem tem token válido. Se restringir,
# liste as origens separadas por vírgula.
#   CORS_ORIGENS=https://portal-ure-leste3.vercel.app,http://localhost:5173
CORS_ORIGENS=

# Sobrescrevem o config.json, úteis para testar sem editar o arquivo.
#   MONITOR_CONFIG=C:\monitor-dvr\config.json
#   INTERVALO_SEGUNDOS=30
#   CONCORRENCIA=48
#   TIMEOUT_PING_MS=1000