# ============================================================
# MONITOR DE REDE — variáveis de ambiente
# Copie para .env ou, melhor, defina como Variável de Ambiente
# do Windows (o serviço precisa delas para subir sozinho).
# ============================================================

# OBRIGATÓRIO. Precisa ser o MESMO valor do SSO_SECRET do backend de
# chamados — é com ele que o serviço valida o token do usuário logado no
# portal. Sem esta variável as rotas /api/* respondem 503.
SSO_SECRET=

# Porta local do serviço. Não precisa estar liberada no roteador:
# quem fala com o navegador é o Cloudflare Tunnel.
PORTA=4000

# Endereço de escuta. 127.0.0.1 (padrão) só aceita conexão da própria
# máquina — é o certo quando o túnel roda na mesma máquina. Use 0.0.0.0
# apenas se o túnel estiver em OUTRO equipamento da rede interna.
HOST=127.0.0.1

# Perfis liberados a ver o monitoramento (padrão: matriz).
# separated por vírgula.
NIVEIS_PERMITIDOS=ADMIN,TECNICO

# Origens do navegador autorizadas a chamar a API (CORS).
# VAZIO = qualquer origem liberada (é o padrão, porque o serviço só
# entrega dados sob token válido). Se preencher, liste os domínios:
#   CORS_ORIGENS=https://seu-portal.vercel.app,http://localhost:5173
CORS_ORIGENS=

# Sobrescrevem o config.json, úteis para testar sem editar o arquivo.
#   MONITOR_CONFIG=C:\...\monitor\config.json
#   INTERVALO_SEGUNDOS=30
#   CONCORRENCIA=48
#   TIMEOUT_PING_MS=1000