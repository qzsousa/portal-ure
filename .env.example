# API do sistema de chamados (autenticação / chamados / usuários)
VITE_API_CHAMADOS_URL=http://localhost:10000/api

# API do SCE (equipamentos / manutenção / empréstimos)
VITE_API_SCE_URL=http://localhost:3000/api

# Serviço de monitoramento das câmeras DVR.
# Roda NA MÁQUINA DA REDE PRIVADA (o navegador não envia ICMP, então quem faz o
# ping é a máquina). Em produção, aponte para o hostname público do Cloudflare
# Tunnel: https://monitor.seudominio.com
VITE_API_MONITOR_URL=http://localhost:4000

# O chat da CaféIA NÃO usa chave nenhuma aqui. As chamadas de LLM saem para o
# backend (POST /api/ia/chat), que guarda as chaves no próprio ambiente. Se a
# chave viesse como VITE_*, o Vite a embutiria no bundle e qualquer pessoa
# leria no console do navegador — além de a NVIDIA bloquear CORS.
